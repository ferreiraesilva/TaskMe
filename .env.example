# Conexão Postgres direta. NÃO usa o MCP.
# Gerada automaticamente pelo deploy-instance.sh (hermes-infra).
# Ex.: postgresql://<role>:<senha>@127.0.0.1:5432/<banco>
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Fuso horário usado para "hoje", vencimentos e digests.
TZ=America/Sao_Paulo

# Comando de envio do Hermes. Em homolog: "hermes send".
# Em outro profile/produção: "hermes --profile projetos send" (ou alias do profile).
# Para testes locais: "echo" (não envia de verdade).
HERMES_SEND_CMD=hermes send

# shared: WhatsApp normal + Telegram previamente vinculado.
# telegram_test: todo remetente do bot representa TASKME_TG_TEST_PHONE.
TASKME_MODE=shared
TASKME_TG_TEST_PHONE=

# Canais de saída: "whatsapp", "telegram" ou "whatsapp,telegram".
TASKME_NOTIFY_CHANNELS=whatsapp
